# Copy to `.env` for local (non-Docker) development. docker-compose.yml
# sets its own values for the container network (see the `x-common-env`
# anchor in that file) -- you normally don't need this file for `docker
# compose up`, only for running individual services with
# `python -m traffic_system...` directly on your machine.

# --- General ---
TRAFFIC_ENV=development
TRAFFIC_LOG_LEVEL=INFO
TRAFFIC_LOG_JSON=false

# --- MQTT (Mosquitto) ---
TRAFFIC_MQTT_HOST=localhost
TRAFFIC_MQTT_PORT=1883

# --- Postgres / TimescaleDB ---
TRAFFIC_POSTGRES_DSN=postgresql+psycopg2://traffic:traffic@localhost:5432/traffic
TRAFFIC_POSTGRES_DSN_ASYNC=postgresql+asyncpg://traffic:traffic@localhost:5432/traffic

# --- Redis ---
TRAFFIC_REDIS_URL=redis://localhost:6379/0

# --- RL brain ---
# torch | numpy | auto (auto tries torch, falls back to the numpy backend)
TRAFFIC_QNET_BACKEND=auto
TRAFFIC_DECISION_INTERVAL_SECONDS=5.0
TRAFFIC_MIN_GREEN_SECONDS=10.0
TRAFFIC_MAX_GREEN_SECONDS=90.0
TRAFFIC_MODEL_DIR=./models

# --- Computer vision ---
# mock (ground-truth from the simulator, no GPU needed) | yolo (real Ultralytics YOLOv8, needs `pip install ultralytics`)
TRAFFIC_CV_BACKEND=mock
TRAFFIC_YOLO_WEIGHTS=yolov8n.pt
TRAFFIC_EMERGENCY_BACKEND=heuristic

# --- API / Dashboard ---
TRAFFIC_API_PORT=8000
TRAFFIC_API_BASE_URL=http://localhost:8000
TRAFFIC_DASHBOARD_PORT=8080
TRAFFIC_CORS_ALLOW_ORIGINS=["*"]
